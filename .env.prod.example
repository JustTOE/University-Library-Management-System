# ULMS production environment.
# Copy to .env.prod (gitignored) and fill in real values before running
# `docker compose -f docker-compose.prod.yml --env-file .env.prod up -d`.

# --- Postgres ---
POSTGRES_USER=ulms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ulms

# --- JWT signing key (>= 32 bytes; generate with `openssl rand -base64 48`) ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes
JWT_LIFETIME_MINUTES=60

# --- CORS / frontend ---
# Public origin the browser uses to reach the app. Must match ULMS_DOMAIN below.
ULMS_FRONTEND_ORIGIN=https://ulms.example.com

# --- Caddy / HTTPS ---
# Domain Caddy will request an LE certificate for.
ULMS_DOMAIN=ulms.example.com
ULMS_ACME_EMAIL=admin@example.com

# --- Mail (real SMTP — MailHog is dev-only) ---
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=apikey
SPRING_MAIL_PASSWORD=replace-me
MAIL_FROM=no-reply@ulms.example.com
ULMS_MAIL_ENABLED=true

# --- JVM tuning (optional) ---
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# --- Backups ---
BACKUP_RETENTION_DAYS=7
